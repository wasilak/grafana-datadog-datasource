{
  "name": "wasilak-datadog-datasource",
  "version": "0.8.0",
  "description": "Datadog datasource",
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "test": "jest --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "lint:fix": "yarn run lint --fix && prettier --write --list-different .",
    "e2e": "playwright test",
    "server": "docker compose up --build",
    "sign": "sign-plugin",
    "postinstall": "find node_modules -type d -name golang -prune -exec rm -rf {} + || true"
  },
  "author": "Piotr Boruc",
  "license": "Apache-2.0",
  "devDependencies": {
    "@grafana/eslint-config": "^10.0.0",
    "@grafana/plugin-e2e": "^3.0.3",
    "@grafana/sign-plugin": "^3.2.2",
    "@grafana/tsconfig": "^2.0.0",
    "@playwright/test": "^1.64.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/core": "^1.3.90",
    "@swc/helpers": "^0.5.0",
    "@swc/jest": "^0.2.26",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "~7.0.0",
    "@testing-library/react": "~16",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.10",
    "@types/node": "~25",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "copy-webpack-plugin": "~14.0.0",
    "css-loader": "~7",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "~10",
    "eslint-plugin-jsdoc": "~65.4.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "~7.1.0",
    "fork-ts-checker-webpack-plugin": "~9",
    "glob": "~13.0.0",
    "identity-obj-proxy": "3.0.0",
    "imports-loader": "^5.0.0",
    "intersection-observer": "^0.12.2",
    "jest": "^30.0.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^30.0.0",
    "prettier": "~3",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "sass": "1.106.1",
    "sass-loader": "~17.0.0",
    "semver": "^7.6.3",
    "style-loader": "~4",
    "swc-loader": "^0.2.3",
    "terser-webpack-plugin": "^5.3.10",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.0",
    "webpack": "^5.94.0",
    "webpack-cli": "^7.0.2",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-subresource-integrity": "^5.1.0",
    "webpack-virtual-modules": "^0.6.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@1.22.22",
  "resolutions": {
    "basic-ftp": "^6.2.3",
    "flatted": "^3.4.2"
  },
  "dependencies": {
    "@datadog/datadog-api-client": "^1.21.0",
    "@emotion/css": "11.13.5",
    "@grafana/data": "^13.2.4",
    "@grafana/i18n": "^13.2.4",
    "@grafana/runtime": "^13.2.4",
    "@grafana/schema": "^13.2.4",
    "@grafana/ui": "^13.2.4",
    "flat-cache": "^6.1.22",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2"
  }
}
